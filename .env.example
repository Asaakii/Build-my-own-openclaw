LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=your_deepseek_api_key_here
LLM_TIMEOUT_SECONDS=30
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_REQUEST_TIMEOUT_SECONDS=30
TELEGRAM_POLL_TIMEOUT_SECONDS=20
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here
REMINDER_MAX_DELAY_SECONDS=3600
REMINDER_MAX_ACTIVE_TASKS=5
# Gateway 只允许本机监听；Token 必须使用本机随机值，不能提交真实值。
MYCLAW_GATEWAY_HOST=127.0.0.1
MYCLAW_GATEWAY_PORT=18790
MYCLAW_GATEWAY_TOKEN=replace_with_a_random_local_gateway_token
